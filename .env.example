# Public browser-safe Supabase configuration. These values identify the
# project and are safe to expose; authorization still depends on RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Used only when the first authenticated owner has no business membership yet.
FIELDCENTRAL_DEFAULT_BUSINESS_NAME=My Field Service Business

# Server-only. Enables AI quoting for owners and co-owners.
# Required on Vercel Production AND Preview (then redeploy) or the estimator fails on new deploys.
# Accepted names (either works): GEMINI_API_KEY or GOOGLE_API_KEY.
# Create a Flash-class key at https://aistudio.google.com/apikey
# Model chain: gemini-3.8-flash → gemini-3.6-flash → gemini-3.5-flash → gemini-2.5-flash.
# Google AI Pro / Ultra is the chat/app plan — it does not replace this API key.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional fallback if you do want xAI (prepaid, separate from SuperGrok):
# XAI_API_KEY=

# Server-only. Joseph chat via OpenRouter.
# Create a key at https://openrouter.ai/keys and add it in Vercel env vars.
OPENROUTER_API_KEY=
# Optional model override. Default: openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
