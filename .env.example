# Public browser-safe Supabase configuration. These values identify the
# project and are safe to expose; authorization still depends on RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Used only when the first authenticated owner has no business membership yet.
FIELDCENTRAL_DEFAULT_BUSINESS_NAME=My Field Service Business

# Server-only. Enables AI quoting for owners and co-owners.
# Gemini is preferred: create a free Flash-class key at https://aistudio.google.com/apikey
# Google AI Pro is the chat/app plan — it does not replace this API key, but the free
# Studio key is enough for quoting volume. SuperGrok does not include xAI API credits.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional fallback if you do want xAI (prepaid, separate from SuperGrok):
# XAI_API_KEY=
